# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=4000

# MySQL connection
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=coffee_shop

# Time zone used by the database for "today", reports and order times
DB_TIMEZONE=+08:00

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Tax in percent (6 = 6%). 0 means no tax. Prices are treated as tax-exclusive.
TAX_RATE=0

# Where the React app runs (for CORS in development)
CLIENT_ORIGIN=http://localhost:5173
